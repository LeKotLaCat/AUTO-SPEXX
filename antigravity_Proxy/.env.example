# --- ขาเข้า (Speexx Solver -> Proxy) ---
PROXY_API_KEYS=speexx-proxy-key
PROXY_MODELS=speexx-solver=gemini-2.5-flash

# --- ขาออก (Proxy -> Google Gemini API) ---
PROXY_UPSTREAM=gemini
PROXY_UPSTREAM_BASE_URL=https://generativelanguage.googleapis.com
PROXY_UPSTREAM_API_KEY=your_gemini_api_key_here
PROXY_UPSTREAM_TIMEOUT_SEC=120
PROXY_MAX_CONCURRENCY=4
PROXY_SCHEMA_MODE=native

# Token storage if using OAuth
PROXY_TOKEN_STORE=/data/session.json
