# ========================================================
# 1. Speexx Login Credentials (For Auto-Login)
# ========================================================
SPEEXX_EMAIL=your_student_id@university.ac.th
SPEEXX_PASSWORD=your_password_here

# ========================================================
# 2. AI Model & API Settings
# ========================================================
# Option A: Antigravity Proxy / LM Studio / Local LLM
LM_STUDIO_URL=http://localhost:8000/v1
LM_STUDIO_MODEL=speexx-solver
PROXY_API_KEY=speexx-proxy-key

# Option B: Direct Gemini API (if using standalone Gemini client)
# GEMINI_API_KEY=your_gemini_api_key_here

# ========================================================
# 3. Pacing & Human-like Delays (in seconds)
# ========================================================
HEADLESS=false

# Time to pause and simulate reading/thinking before answering
MIN_THINK_TIME=3.0
MAX_THINK_TIME=6.0

# Delay between sub-items (e.g. blanks 1 -> 2, choices 1 -> 2)
SUB_ITEM_DELAY_MIN=2.0
SUB_ITEM_DELAY_MAX=4.0

# Delay to review answers before clicking Correction (Submit)
REVIEW_DELAY_MIN=2.0
REVIEW_DELAY_MAX=4.0

# Typing speed delay (in milliseconds per character)
MIN_TYPING_DELAY_MS=20
MAX_TYPING_DELAY_MS=60

# Pause after passing an exercise before advancing to Next
PAUSE_BETWEEN_QUESTIONS_MIN=3.0
PAUSE_BETWEEN_QUESTIONS_MAX=6.0
